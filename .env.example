# Copy to .env for local runs. Never commit a real key.

MEDIA_ANALYSIS_KEY=dev-only-change-me
MEDIA_ANALYSIS_ALLOWED_HOSTS=localhost,127.0.0.1

MEDIA_ANALYSIS_MAX_DURATION_SEC=60
MEDIA_ANALYSIS_MAX_WIDTH=1920
MEDIA_ANALYSIS_MAX_HEIGHT=1920
MEDIA_ANALYSIS_MAX_BYTES=83886080
MEDIA_ANALYSIS_DOWNLOAD_TIMEOUT_SEC=30
MEDIA_ANALYSIS_JOB_TIMEOUT_SEC=240

# Local default. The container uses /models.
MEDIA_ANALYSIS_MODEL_DIR=./models
MEDIA_ANALYSIS_IMAGE=analysis-cpu
# Test suites set this explicitly. Never enable it for a real worker.
MEDIA_ANALYSIS_ALLOW_STUB_MODELS=false
# v2 benchmark/reference workers only. Production must leave this false.
MEDIA_ANALYSIS_MATTE_REFERENCE_MODE=false
