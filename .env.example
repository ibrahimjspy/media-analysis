# Copy to .env for local runs. Never commit a real key.

MEDIA_ANALYSIS_KEY=dev-only-change-me
MEDIA_ANALYSIS_ALLOWED_HOSTS=localhost,127.0.0.1

MEDIA_ANALYSIS_MAX_DURATION_SEC=60
MEDIA_ANALYSIS_MAX_WIDTH=1920
MEDIA_ANALYSIS_MAX_HEIGHT=1920
MEDIA_ANALYSIS_MAX_BYTES=83886080
MEDIA_ANALYSIS_MAX_DECODED_PIXELS=6635520000
MEDIA_ANALYSIS_DOWNLOAD_TIMEOUT_SEC=30
MEDIA_ANALYSIS_JOB_TIMEOUT_SEC=240
MEDIA_ANALYSIS_STAGE_TIMEOUT_SEC=60
MEDIA_ANALYSIS_FEATURE_WORKERS=3
MEDIA_ANALYSIS_FRAME_CACHE_BYTES=268435456
# Job-local sampled frame spill; 0 disables it. Cleared after every request.
MEDIA_ANALYSIS_FRAME_SPILL_BYTES=2147483648
MEDIA_ANALYSIS_MOTION_MAX_DIMENSION=640

# Content-addressed source/canonical/result cache. Cache hits require source.sha256.
MEDIA_ANALYSIS_CACHE_ENABLED=true
MEDIA_ANALYSIS_CACHE_DIR=/var/tmp/media-analysis/cache
MEDIA_ANALYSIS_CACHE_MAX_BYTES=2147483648
MEDIA_ANALYSIS_CACHE_TTL_SEC=86400

# Local default. The container uses /models.
MEDIA_ANALYSIS_MODEL_DIR=./models
MEDIA_ANALYSIS_IMAGE=analysis-cpu
# Production deployments should run separate general and OCR replicas.
# combined preserves the single-service API for local development.
MEDIA_ANALYSIS_WORKER_ROLE=combined
# Test suites set this explicitly. Never enable it for a real worker.
MEDIA_ANALYSIS_ALLOW_STUB_MODELS=false
# v2 benchmark/reference workers only. Production must leave this false.
MEDIA_ANALYSIS_MATTE_REFERENCE_MODE=false
# Production matte workers should set tensorrt (FP16) or cuda; auto permits CPU fallback.
MEDIA_ANALYSIS_MATTE_EXECUTION_PROVIDER=auto
MEDIA_ANALYSIS_MATTE_KEYFRAME_INTERVAL=3
MEDIA_ANALYSIS_TENSORRT_CACHE_DIR=/var/tmp/media-analysis/tensorrt
